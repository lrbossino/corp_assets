# V3 Research Application - Environment Configuration
# Copy this file to .env and fill in your actual values

# Batch API Configuration
# For Doubleword: Get your API key from https://console.doubleword.ai
# For OpenAI: Get your API key from https://platform.openai.com/api-keys
BATCH_API_KEY=dw_dummy_key_replace_with_actual_key

# Batch Provider: "openai" or "doubleword"
BATCH_PROVIDER=doubleword

# Optional: Override default model
# BATCH_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8

# Optional: Output directory
# OUTPUT_DIR=./research_output_v3

# Optional: Rules configuration file
# RULES_CONFIG=./config.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
